{
    "schemaVersion": 1,
    "id": "skyos",
    "version": "${version}",
    "name": "SkyOS",
    "description": "A feature-rich Hypixel Skyblock client mod.",
    "authors": ["SkyOS Team"],
    "contact": {
        "sources": "https://github.com/freelocs-dev/SkyOS"
    },
    "license": "MIT",
    "icon": "assets/skyos/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            {
                "value": "dev.skyos.SkyOsMod",
                "adapter": "kotlin"
            }
        ],
        "modmenu": [
            "dev.skyos.modmenu.SkyOsModMenuIntegration"
        ]
    },
    "mixins": ["skyos.mixins.json"],
    "depends": {
        "fabricloader": ">=0.19.0",
        "minecraft": "~1.21.11",
        "java": ">=21",
        "fabric-api": "*",
        "fabric-language-kotlin": ">=1.10.0+kotlin.1.9.0"
    },
    "suggests": {
        "modmenu": "*"
    }
}
